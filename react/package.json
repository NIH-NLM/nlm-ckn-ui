{
  "name": "frontend",
  "proxy": "http://127.0.0.1:8000",
  "version": "0.1.0",
  "homepage": ".",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@reduxjs/toolkit": "^2.8.2",
    "d3": "^7.9.0",
    "npm-watch": "^0.13.0",
    "rc-slider": "^11.1.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.29.0",
    "react-scripts": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-undo": "^1.1.0",
    "uuid": "^8.3.2"
  },
  "watch": {
    "build": {
      "patterns": [
        "src",
        "public"
      ],
      "extensions": "js,jsx,json,html,css",
      "legacyWatch": true,
      "delay": 500
    }
  },
  "scripts": {
    "start": "DISABLE_ESLINT_PLUGIN=true react-scripts start",
    "build-react": "DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "collectstatic-django": "(cd .. && python manage.py collectstatic --noinput)",
    "build": "npm run build-react && npm run collectstatic-django",
    "test": "react-scripts test",
    "test:e2e": "playwright test",
    "test:e2e:local": "E2E_SERVE_BUILD=1 E2E_PORT=3100 playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:artifacts": "playwright test --config=playwright.artifacts.config.ts",
    "e2e:report": "playwright show-report",
    "test:design": "playwright test --config=playwright.design.config.ts",
    "eject": "react-scripts eject",
    "watch": "npm-watch",
    "check": "biome ci .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@biomejs/biome": "^2.2.5",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "serve": "^14.2.6"
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!d3)/"
    ]
  }
}
